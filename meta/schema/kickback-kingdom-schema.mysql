r_card_border_media`,`v_account_equipment_media`.`banner_media` AS `banner_media`,`v_account_equipment_media`.`background_media` AS `background_media`,`v_account_equipment_media`.`charm_media` AS `charm_media`,`v_account_equipment_media`.`companion_media` AS `companion_media` from ((((((`account` left join `v_account_experience` on(`account`.`Id` = `v_account_experience`.`account_id`)) left join `v_account_prestige_net` on(`account`.`Id` = `v_account_prestige_net`.`account_id`)) left join `v_account_badge_count` on(`account`.`Id` = `v_account_badge_count`.`account_id`)) left join `v_admins` on(`v_admins`.`account_id` = `account`.`Id`)) left join `v_account_permisions` on(`v_account_permisions`.`account_id` = `account`.`Id`)) left join `v_account_equipment_media` on(`account`.`Id` = `v_account_equipment_media`.`account_id`)) */;
