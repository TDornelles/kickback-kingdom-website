/*!50001 CREATE ALGORITHM=UNDEFINED */
/*!50013 DEFINER=`$definer_user`@`$definer_host` SQL SECURITY DEFINER */
/*!50001 VIEW `v_account_activity` AS select `v_account_activity`.`Type` AS `type`,`v_account_activity`.`account_id` AS `account_id`,`v_account_activity`.`event_verb` AS `event_verb`,`v_account_activity`.`event_name_id` AS `event_name_id`,`v_account_activity`.`event_name` AS `event_name`,`v_account_activity`.`event_team` AS `event_team`,`v_account_activity`.`event_character` AS `event_character`,`v_account_activity`.`event_character_was_random` AS `event_character_was_random`,`v_account_activity`.`event_date` AS `event_date`,`v_account_activity`.`event_icon_id` AS `event_icon_id`,coalesce(`v_account_activity`.`event_icon_path`,concat(`Media`.`Directory`,'/',`Media`.`Id`,'.',`Media`.`extension`)) AS `event_icon_path`,`v_account_activity`.`event_url` AS `event_url`,`v_account_activity`.`finished` AS `finished`,`v_account_activity`.`published` AS `published` from (((select 'GAME-RECORD' AS `Type`,`game_record`.`account_id` AS `account_id`,if(`game_record`.`win`,'WON','LOST') AS `event_verb`,`game`.`Id` AS `event_name_id`,`game`.`Name` AS `event_name`,`game_record`.`team_name` AS `event_team`,`game_record`.`character` AS `event_character`,`game_record`.`random_character` AS `event_character_was_random`,`game_record`.`Date` AS `event_date`,`game`.`media_icon_id` AS `event_icon_id`,NULL AS `event_icon_path`,NULL AS `event_url`,1 AS `finished`,1 AS `published` from (`game_record` left join `game` on(`game`.`Id` = `game_record`.`game_id`))) union select 'QUEST-PARTICIPANT' AS `Type`,`quest_applicants`.`account_id` AS `account_id`,if(`quest_applicants`.`participated`,'PARTICIPATED IN','BAILED ON') AS `event_verb`,`quest_applicants`.`quest_id` AS `event_name_id`,`quest`.`name` AS `event_name`,`v_tournament_results`.`team_name` AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`quest`.`end_date` AS `event_date`,`quest`.`image_id_icon` AS `event_icon_id`,NULL AS `event_icon_path`,concat('q/',`quest`.`locator`) AS `event_url`,`quest`.`finished` AS `finished`,`quest`.`published` AS `published` from ((`quest_applicants` left join `quest` on(`quest`.`Id` = `quest_applicants`.`quest_id`)) left join `v_tournament_results` on(`v_tournament_results`.`tournament_id` = `quest`.`tournament_id` and `v_tournament_results`.`account_id` = `quest_applicants`.`account_id`)) union select 'BADGE' AS `Type`,`loot`.`account_id` AS `account_id`,if(`item`.`nominated_by_id` is not null,'NOMINATED','EARNED') AS `event_verb`,`item`.`Id` AS `event_name_id`,`item`.`name` AS `event_name`,NULL AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`loot`.`dateObtained` AS `event_date`,`item`.`media_id_small` AS `event_icon_id`,NULL AS `event_icon_path`,NULL AS `event_url`,1 AS `finished`,1 AS `published` from (`loot` left join `item` on(`loot`.`item_id` = `item`.`Id`)) where `item`.`type` = 0 union select 'SPENT-PRESTIGE-TOKEN' AS `Type`,`prestige`.`account_id_from` AS `account_id`,if(`prestige`.`commend`,'COMMENDED','DENOUNCED') AS `event_verb`,`prestige`.`account_id_to` AS `event_name_id`,`account`.`Username` AS `event_name`,NULL AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`prestige`.`date` AS `event_date`,NULL AS `event_icon_id`,`v_account_equipment_media`.`avatar_media` AS `event_icon_path`,NULL AS `event_url`,1 AS `finished`,1 AS `published` from ((`prestige` left join `v_account_equipment_media` on(`v_account_equipment_media`.`account_id` = `prestige`.`account_id_to`)) left join `account` on(`prestige`.`account_id_to` = `account`.`Id`)) union select 'RECEIVED-PRESTIGE' AS `Type`,`prestige`.`account_id_to` AS `account_id`,if(`prestige`.`commend`,'COMMENDED','DENOUNCED') AS `event_verb`,`prestige`.`account_id_from` AS `event_name_id`,`account`.`Username` AS `event_name`,NULL AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`prestige`.`date` AS `event_date`,NULL AS `event_icon_id`,`v_account_equipment_media`.`avatar_media` AS `event_icon_path`,NULL AS `event_url`,1 AS `finished`,1 AS `published` from ((`prestige` left join `v_account_equipment_media` on(`v_account_equipment_media`.`account_id` = `prestige`.`account_id_from`)) left join `account` on(`prestige`.`account_id_from` = `account`.`Id`)) union select 'QUEST-HOSTED' AS `Type`,`quest`.`host_id` AS `account_id`,if(`quest`.`host_id_2` is null,'HOSTED','CO-HOSTED') AS `event_verb`,`quest`.`Id` AS `event_name_id`,`quest`.`name` AS `event_name`,NULL AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`quest`.`end_date` AS `event_date`,`quest`.`image_id_icon` AS `event_icon_id`,NULL AS `event_icon_path`,concat('q/',`quest`.`locator`) AS `event_url`,`quest`.`finished` AS `finished`,`quest`.`published` AS `published` from `quest` where `quest`.`published` = 1 union select 'QUEST-HOSTED' AS `Type`,`quest`.`host_id_2` AS `account_id`,'CO-HOSTED' AS `event_verb`,`quest`.`Id` AS `event_name_id`,`quest`.`name` AS `event_name`,NULL AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`quest`.`end_date` AS `event_date`,`quest`.`image_id_icon` AS `event_icon_id`,NULL AS `event_icon_path`,concat('q/',`quest`.`locator`) AS `event_url`,`quest`.`finished` AS `finished`,`quest`.`published` AS `published` from `quest` where `quest`.`published` = 1 and `quest`.`host_id_2` is not null union select 'WROTE-BLOG-POST' AS `Type`,`blog_post`.`Author_id` AS `account_id`,'WROTE' AS `event_verb`,`blog_post`.`Id` AS `event_name_id`,`blog_post`.`Title` AS `event_name`,NULL AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`blog_post`.`PostDate` AS `event_date`,`blog_post`.`Image_id` AS `event_icon_id`,NULL AS `event_icon_path`,NULL AS `event_url`,`blog_post`.`Published` AS `finished`,`blog_post`.`Published` AS `published` from `blog_post` where `blog_post`.`Published` = 1 union select 'TOURNAMENT' AS `Type`,`v_tournament_results`.`account_id` AS `account_id`,if(`v_tournament_results`.`win`,'WON','LOST') AS `event_verb`,`v_tournament_results`.`tournament_id` AS `event_name_id`,`quest`.`name` AS `event_name`,`v_tournament_results`.`team_name` AS `event_team`,NULL AS `event_character`,NULL AS `event_character_was_random`,`quest`.`end_date` AS `event_date`,`quest`.`image_id_icon` AS `event_icon_id`,NULL AS `event_icon_path`,concat('q/',`quest`.`locator`) AS `event_url`,`quest`.`finished` AS `finished`,`quest`.`published` AS `published` from (`v_tournament_results` left join `quest` on(`v_tournament_results`.`tournament_id` = `quest`.`tournament_id`))) `v_account_activity` left join `Media` on(`v_account_activity`.`event_icon_id` = `Media`.`Id` and `v_account_activity`.`event_icon_id` is not null)) where `v_account_activity`.`event_date` < current_timestamp() order by `v_account_activity`.`event_date` desc */;
/*!50001 SET character_set_client      = @saved_cs_client */;
/*!50001 SET character_set_results     = @saved_cs_results */;
