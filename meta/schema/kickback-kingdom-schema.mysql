  `severity` tinyint(3) unsigned DEFAULT NULL COMMENT '1=cosmetic, 2=minor, 3=major, 4=critical',
  `subject` varchar(255) NOT NULL,
  `description` text NOT NULL,
  `tags_json` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`tags_json`)),
  `updated_at` datetime(6) NOT NULL,
  `first_response_at` datetime(6) DEFAULT NULL,
  `resolved_at` datetime(6) DEFAULT NULL,
  `closed_at` datetime(6) DEFAULT NULL,
  `created_ip` varchar(45) DEFAULT NULL,
  `user_agent` varchar(255) DEFAULT NULL,
  `is_deleted` tinyint(1) NOT NULL DEFAULT 0,
  `deleted_at` datetime(6) DEFAULT NULL,
  `updated_by_crand` int(11) DEFAULT NULL,
  PRIMARY KEY (`ctime`,`crand`),
  KEY `idx_ticket_creator` (`created_by_crand`),
  KEY `idx_ticket_category` (`category`),
  KEY `idx_ticket_guild` (`guild_id`),
  KEY `idx_ticket_game` (`game_id`),
  KEY `idx_ticket_server` (`server_ctime`,`server_crand`),
  KEY `idx_ticket_status` (`status`),
  KEY `idx_ticket_priority` (`priority`),
  KEY `idx_ticket_updated_at` (`updated_at`),
  KEY `idx_ticket_updated_by` (`updated_by_crand`),
  KEY `idx_ticket_not_deleted` (`is_deleted`,`updated_at`),
  FULLTEXT KEY `ft_ticket_search` (`subject`,`description`),
  CONSTRAINT `fk_ticket_category_slug` FOREIGN KEY (`category`) REFERENCES `ticket_category` (`slug`) ON DELETE SET NULL ON UPDATE CASCADE,
  CONSTRAINT `fk_ticket_created_by` FOREIGN KEY (`created_by_crand`) REFERENCES `account` (`Id`) ON DELETE SET NULL,
  CONSTRAINT `fk_ticket_game` FOREIGN KEY (`game_id`) REFERENCES `game` (`Id`) ON DELETE SET NULL,
  CONSTRAINT `fk_ticket_guild` FOREIGN KEY (`guild_id`) REFERENCES `guild` (`Id`) ON DELETE SET NULL,
  CONSTRAINT `fk_ticket_server` FOREIGN KEY (`server_ctime`, `server_crand`) REFERENCES `server` (`ctime`, `crand`) ON DELETE SET NULL,
  CONSTRAINT `fk_ticket_updated_by` FOREIGN KEY (`updated_by_crand`) REFERENCES `account` (`Id`) ON DELETE SET NULL,
  CONSTRAINT `CONSTRAINT_1` CHECK (`status` in ('open','in_progress','resolved','closed')),
  CONSTRAINT `CONSTRAINT_2` CHECK (`priority` between 1 and 4),
  CONSTRAINT `CONSTRAINT_3` CHECK (`severity` is null or `severity` between 1 and 4),
  CONSTRAINT `CONSTRAINT_4` CHECK (`tags_json` is null or json_valid(`tags_json`))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
