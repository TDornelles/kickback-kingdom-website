/*!50001 VIEW `v_lich_card_source_stats` AS with TotalCards as (select count(0) AS `total_count` from `lich_card`), SourceLessCards as (select 'Source-less' AS `category`,count(0) AS `total_count` from `lich_card` where `lich_card`.`source_arcanic` = 0 and `lich_card`.`source_abyssal` = 0 and `lich_card`.`source_thermic` = 0 and `lich_card`.`source_verdant` = 0 and `lich_card`.`source_luminate` = 0), SingleSourceStats as (select 'Arcanic' AS `category`,count(0) AS `total_count` from `lich_card` where `lich_card`.`source_arcanic` > 0 and `lich_card`.`source_abyssal` = 0 and `lich_card`.`source_thermic` = 0 and `lich_card`.`source_verdant` = 0 and `lich_card`.`source_luminate` = 0 union all select 'Abyssal' AS `Abyssal`,count(0) AS `COUNT(*)` from `lich_card` where `lich_card`.`source_abyssal` > 0 and `lich_card`.`source_arcanic` = 0 and `lich_card`.`source_thermic` = 0 and `lich_card`.`source_verdant` = 0 and `lich_card`.`source_luminate` = 0 union all select 'Thermic' AS `Thermic`,count(0) AS `COUNT(*)` from `lich_card` where `lich_card`.`source_thermic` > 0 and `lich_card`.`source_arcanic` = 0 and `lich_card`.`source_abyssal` = 0 and `lich_card`.`source_verdant` = 0 and `lich_card`.`source_luminate` = 0 union all select 'Verdant' AS `Verdant`,count(0) AS `COUNT(*)` from `lich_card` where `lich_card`.`source_verdant` > 0 and `lich_card`.`source_arcanic` = 0 and `lich_card`.`source_abyssal` = 0 and `lich_card`.`source_thermic` = 0 and `lich_card`.`source_luminate` = 0 union all select 'Luminate' AS `Luminate`,count(0) AS `COUNT(*)` from `lich_card` where `lich_card`.`source_luminate` > 0 and `lich_card`.`source_arcanic` = 0 and `lich_card`.`source_abyssal` = 0 and `lich_card`.`source_thermic` = 0 and `lich_card`.`source_verdant` = 0), ComboSourceStats as (select trim(trailing ', ' from concat(if(`lich_card`.`source_arcanic` > 0,'Arcanic, ',''),if(`lich_card`.`source_abyssal` > 0,'Abyssal, ',''),if(`lich_card`.`source_thermic` > 0,'Thermic, ',''),if(`lich_card`.`source_verdant` > 0,'Verdant, ',''),if(`lich_card`.`source_luminate` > 0,'Luminate, ',''))) AS `category`,count(0) AS `total_count` from `lich_card` where (`lich_card`.`source_arcanic` > 0) + (`lich_card`.`source_abyssal` > 0) + (`lich_card`.`source_thermic` > 0) + (`lich_card`.`source_verdant` > 0) + (`lich_card`.`source_luminate` > 0) > 1 group by trim(trailing ', ' from concat(if(`lich_card`.`source_arcanic` > 0,'Arcanic, ',''),if(`lich_card`.`source_abyssal` > 0,'Abyssal, ',''),if(`lich_card`.`source_thermic` > 0,'Thermic, ',''),if(`lich_card`.`source_verdant` > 0,'Verdant, ',''),if(`lich_card`.`source_luminate` > 0,'Luminate, ',''))))select 'Total Cards' AS `category`,`TotalCards`.`total_count` AS `total_count` from `TotalCards` union all select `SourceLessCards`.`category` AS `category`,`SourceLessCards`.`total_count` AS `total_count` from `SourceLessCards` union all select `SingleSourceStats`.`category` AS `category`,`SingleSourceStats`.`total_count` AS `total_count` from `SingleSourceStats` union all select `ComboSourceStats`.`category` AS `category`,`ComboSourceStats`.`total_count` AS `total_count` from `ComboSourceStats` order by `total_count` desc */;
